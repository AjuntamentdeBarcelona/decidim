<% show_only_added ||= params.dig(:filter, :addition_type) == "added" %>
<% hide_vote_button = !@focus_mode %>

<%= card_for project, render_extra_data: true,
                      link_whole_card: false,
                      wrapper_class: "project-item",
                      show_only_added:,
                      hide_vote_button:,
                      focus_mode: @focus_mode || voting_open? && current_workflow.vote_allowed?(budget),
                      authorization_redirect_path: @focus_mode ? budget_focus_projects_path(budget, start_voting: true) : budget_projects_path(budget) %>
